# ---------- Provider selection ----------
# massive | tradier | demo
DATA_PROVIDER=demo
FALLBACK_PROVIDER=tradier

# ---------- API keys (SERVER ONLY - never expose to frontend) ----------
MASSIVE_API_KEY=
MASSIVE_BASE_URL=https://api.massive.dev/v1
MASSIVE_WS_URL=wss://stream.massive.dev/v1

TRADIER_API_KEY=
# https://sandbox.tradier.com/v1 for sandbox tokens
TRADIER_BASE_URL=https://api.tradier.com/v1

ORATS_API_KEY=
ORATS_BASE_URL=https://api.orats.io/datav2

# ---------- Infrastructure ----------
DATABASE_URL=postgresql+asyncpg://gex:gex@localhost:5432/gex
REDIS_URL=redis://localhost:6379/0

# ---------- Behaviour ----------
DEMO_MODE=true
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Cache TTLs (seconds)
CACHE_TTL_CHAIN=45
CACHE_TTL_UNDERLYING=5
CACHE_TTL_EXPIRATIONS=900
CACHE_TTL_BARS=60

# ---------- Quant defaults ----------
# calls_positive_puts_negative | all_positive | put_positive_call_negative
GEX_SIGN_CONVENTION=calls_positive_puts_negative
CONTRACT_MULTIPLIER_DEFAULT=100
RISK_FREE_RATE=0.043
DIVIDEND_YIELD=0.0

# ---------- Frontend (public) ----------
NEXT_PUBLIC_API_BASE=http://localhost:8000
